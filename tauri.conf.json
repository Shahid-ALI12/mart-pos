{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mart POS",
  "version": "0.1.0",
  "identifier": "com.shahidali.martpos",
  "build": {
    "beforeDevCommand": "pnpm dev --prefix frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mart POS - Point of Sale",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true,
        "label": "main",
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "wix": {
        "language": "en-US",
        "template": "main.wxs",
        "fragmentPaths": [],
        "componentGroupRefs": [],
        "componentRefs": [],
        "featureRefs": [],
        "mergeRefs": []
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHeaderIcon": "icons/icon.ico",
        "license": "",
        "headerBitmap": "",
        "welcomeBitmap": "",
        "bitmap": "",
        "language": "English",
        "strings": {
          "installDir": "$PROGRAMFILES64\\Mart POS",
          "companyName": "Shahid Ali",
          "productName": "Mart POS",
          "productVersion": "0.1.0",
          "shortcuts": {
            "startMenu": [
              {
                "name": "Mart POS",
                "parameters": "",
                "workingDirectory": "",
                "iconPath": "",
                "iconIndex": 0
              }
            ],
            "desktop": true
          }
        }
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "appStore": {
        "commit": false,
        "category": "public.app-category.business"
      },
      "infoPlist": {
        "NSHumanReadableCopyright": "© 2024 Shahid Ali. All rights reserved."
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common"
        ],
        "section": "office",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator3-1",
          "librsvg2"
        ],
        "license": "MIT",
        "section": "Office",
        "priority": "optional"
      }
    },
    "longDescription": "A comprehensive desktop POS and ERP system for large general stores/marts with multi-counter support, inventory management, billing, reports, and GST compliance.",
    "externalBin": [],
    "copyright": "© 2024 Shahid Ali",
    "category": "Business",
    "shortDescription": "Mart POS/ERP System",
    "license": "MIT",
    "licenseFile": "",
    "createUpdaterArtifacts": true,
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Shahid-ALI12/mart-pos/releases/latest/download/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:main.db"],
      "encryption": "sqlcipher"
    },
    "store": {
      "filename": "settings.dat"
    },
    "log": {
      "level": "info",
      "format": "json",
      "target": "file",
      "targets": ["stdout", "file"]
    }
  }
}